# 后端环境变量示例（请复制为 .env 并填写真实值）
#
# 复制命令：
#   cd FishStudio/backend
#   cp env.example .env

# ─── 必填：数据库与认证 ───────────────────────────────
# Postgres 连接串（asyncpg 驱动）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fishstudio

# JWT 签名密钥（生产环境务必使用 openssl rand -hex 32 生成长随机串）
JWT_SECRET=please-change-me-to-a-long-random-string-min-16-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# 启动时 upsert 的管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-me-min-8-chars

# CORS 允许的前端域名（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── LLM 与厂商配置 ──────────────────────────────────
# LLM 提供商配置
# 支持的提供商: volcano（火山引擎，默认）、siliconflow（SiliconFlow）
LLM_PROVIDER=volcano

# SiliconFlow LLM 配置（当 LLM_PROVIDER=siliconflow 时使用）
OPENAI_API_KEY=YOUR_API_KEY_HERE
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
MODEL_NAME=deepseek-ai/DeepSeek-V3.1-Terminus

# 图像生成/编辑模型（SiliconFlow images 接口使用）
IMAGE_MODEL_NAME=Qwen/Qwen-Image
EDIT_IMAGE_MODEL_NAME=Qwen/Qwen-Image-Edit-2509

# 用于将本地 /storage/... 拼成可访问的完整 URL（edit_image 需要）
BASE_URL=http://localhost:8000

# LangGraph 多步推理递归上限
RECURSION_LIMIT=200

# 火山引擎配置（图片生成 + LLM）
VOLCANO_API_KEY=YOUR_VOLCANO_API_KEY_HERE
VOLCANO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 火山引擎图片生成模型
VOLCANO_IMAGE_MODEL=seedream-4.5
VOLCANO_EDIT_MODEL=seedream-4.5
# 火山引擎视频生成模型（使用 Seedance 1.5 Pro，支持文生视频、图生视频-首帧、首尾帧）
VOLCANO_VIDEO_MODEL=doubao-seedance-1-5-pro
# 火山引擎 LLM 模型（当 LLM_PROVIDER=volcano 时使用）
VOLCANO_MODEL_NAME=doubao-seed-1-6-251015
# 是否启用 thinking 功能（深度思考能力）：true 或 false
VOLCANO_THINKING_ENABLED=false

# LLM Token 人民币计价（每百万 Token）；未配置时仍记录 Token，费用标记为 pricing_unavailable
LLM_INPUT_PRICE_CNY_PER_MILLION=
LLM_CACHED_INPUT_PRICE_CNY_PER_MILLION=
LLM_OUTPUT_PRICE_CNY_PER_MILLION=
LLM_PRICE_TABLE_VERSION=unconfigured

# MiniMax 视频生成配置（主路径：官方公开 V1 协议，Hailuo-2.3 / 2.3-Fast / 02）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com
# V1 标准模型 / 省钱预览模型（preview+first_frame 时选用）
MINIMAX_V1_MODEL=MiniMax-Hailuo-2.3
MINIMAX_FAST_MODEL=MiniMax-Hailuo-2.3-Fast
# H3 实验分支开关（默认 false）：H3 的 /v2 协议未经官方文档核验，开启后
# balanced 路由恢复 minimax(H3) 优先；生产环境请保持 false
MINIMAX_H3_EXPERIMENTAL=false
MINIMAX_H3_MODEL=MiniMax-H3

# =============================================================================
# 远端自托管 MiniMax H3（FishStudio + Gateway 的唯一配置模板）
#
# FishStudio 使用 LOCAL_H3_*；192.168.10.60 Gateway 使用 H3_GATEWAY_* / H3_COMFY_*。
# 两端从本文件复制配置，Token、Deployment、Model 必须保持一致。
# 与 MiniMax 官方云 API 完全分离。
# =============================================================================

# 是否启用 FishStudio 的 Local H3 路由；Gateway 健康检查通过前保持 false。
LOCAL_H3_ENABLED=false

# FishStudio 锁定的自托管部署标识；必须与 H3_GATEWAY_DEPLOYMENT 相同。
LOCAL_H3_DEPLOYMENT=h3-fl2va-int8-convrot

# FishStudio 可访问的 Gateway 地址；不要填写 ComfyUI 的 8190 端口。
LOCAL_H3_BASE_URL=

# FishStudio 请求 Gateway 的 Bearer Token；必须与 H3_GATEWAY_API_KEY 相同。
LOCAL_H3_API_KEY=

# FishStudio 锁定的逻辑模型名称；必须与 H3_GATEWAY_MODEL 相同。
LOCAL_H3_MODEL=MiniMax-H3

# 只声明已经验证的工作流能力；图生视频联调完成后再追加模式。
LOCAL_H3_MODES=text

# 16GB 单卡允许的最大并发数，首期固定为 1。
LOCAL_H3_MAX_CONCURRENCY=1

# FishStudio 对该部署开放的最短视频秒数。
LOCAL_H3_MIN_DURATION=4

# FishStudio 对该部署开放的最长视频秒数，首期限制为 6。
LOCAL_H3_MAX_DURATION=6

# FishStudio 调用 Gateway 普通 HTTP 接口的超时秒数。
LOCAL_H3_TIMEOUT_SECONDS=30

# FishStudio 下载最终 MP4 Artifact 的超时秒数。
LOCAL_H3_ARTIFACT_TIMEOUT_SECONDS=900

# FishStudio 接受的单个视频最大字节数，默认 512 MiB。
LOCAL_H3_MAX_ARTIFACT_BYTES=536870912

# 以后启用首尾帧时，允许内联到请求中的单张图片上限，默认 8 MiB。
LOCAL_H3_MAX_INLINE_IMAGE_BYTES=8388608

# Artifact 与 Gateway 不同主机时填写允许的主机名，多个值用逗号分隔。
LOCAL_H3_ARTIFACT_ALLOWED_HOSTS=

# 自托管每输出秒的人民币成本；留空时系统标记 pricing_unavailable。
LOCAL_H3_COST_CNY_PER_SECOND=

# Gateway 校验 FishStudio 请求的 Bearer Token；必须与 LOCAL_H3_API_KEY 相同。
H3_GATEWAY_API_KEY=

# Gateway 访问同机 ComfyUI 的内部地址。
H3_COMFY_URL=http://127.0.0.1:8190

# Gateway 返回给 FishStudio 的自身及 Artifact 基地址。
H3_GATEWAY_PUBLIC_URL=http://192.168.10.60:8088

# Gateway 部署标识；必须与 LOCAL_H3_DEPLOYMENT 相同。
H3_GATEWAY_DEPLOYMENT=h3-fl2va-int8-convrot

# Gateway 模型标识；必须与 LOCAL_H3_MODEL 相同。
H3_GATEWAY_MODEL=MiniMax-H3

# 已验证的 ComfyUI API Format 工作流绝对路径。
H3_GATEWAY_WORKFLOW=/root/.myservice/h3-gateway/gateway/workflows/video_minimax_h3_t2v.json

# Gateway SQLite 队列、幂等记录和 MP4 Artifact 的持久化目录。
H3_GATEWAY_STATE_DIR=/root/.myservice/h3-gateway/state

# Gateway 查询 ComfyUI /history 的轮询间隔秒数。
H3_GATEWAY_POLL_SECONDS=2

# Gateway 调用 ComfyUI 普通接口的超时秒数。
H3_GATEWAY_COMFY_TIMEOUT_SECONDS=30

# Gateway 从 ComfyUI 下载完整视频的超时秒数。
H3_GATEWAY_ARTIFACT_TIMEOUT_SECONDS=900

# Gateway 等待队列的最大任务数，超过后返回 HTTP 429。
H3_GATEWAY_MAX_QUEUE=8

# Gateway 接受的单个视频最大字节数，默认 512 MiB。
H3_GATEWAY_MAX_ARTIFACT_BYTES=536870912

# 是否强制使用已经下载的 8-step H3 Turbo LoRA。
H3_GATEWAY_TURBO=true

# ComfyUI models/loras 下的 Turbo LoRA 文件名。
H3_GATEWAY_TURBO_LORA=minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors

# Turbo 开启时实际使用的采样步数。
H3_GATEWAY_TURBO_STEPS=8

# 已在 ComfyUI 中手动验证过的模式，逗号分隔：text / first_frame / first_last_frame。
# 开启图生视频前，先在 ComfyUI 里给 MiniMaxH3ImageToVideo 接一张图跑通一次。
# FishStudio 侧需同步把 Local H3 Deployment 的能力 modes 改为相同列表，路由才会选中它。
H3_GATEWAY_MODES=text

# MiniMaxH3ImageToVideo 节点的首帧 / 尾帧 IMAGE 输入名；留空时从 ComfyUI /object_info 自动识别。
H3_GATEWAY_FIRST_FRAME_INPUT=
H3_GATEWAY_LAST_FRAME_INPUT=

# 单张首帧/尾帧图片大小上限（字节）。
H3_GATEWAY_MAX_IMAGE_BYTES=10485760
# 产物保留小时数，过期的视频每小时清理一次（FishStudio 完成后会立即下载）；0 表示不清理。
H3_GATEWAY_RETENTION_HOURS=24
# ComfyUI 的 output / input 目录（可选）：只清理 output/fishstudio/ 下的视频和 input 里 fishstudio_ 开头的上传帧。
H3_COMFY_OUTPUT_DIR=
H3_COMFY_INPUT_DIR=

# Mock Provider 兜底开关（默认 false）：无真实 provider 时是否允许 mock 生成
# ⚠️ 生产环境严禁设为 true，仅测试/本地演示使用
ALLOW_MOCK_PROVIDERS=false

# 节点画布每日云端花费上限（元）。按 BUDGET_TIMEZONE 的自然日统计，进行中的任务按预估计入；
# 本地自托管模型（如 MiniMax H3 Gateway）不计入。留空或 0 表示不限。
DAILY_BUDGET_CNY=20
BUDGET_TIMEZONE=Asia/Shanghai

# 生产 Job Runtime：Redis 只负责通知，PostgreSQL 仍为任务真相源
REDIS_URL=redis://localhost:6379/0
WORKER_ID=
# 可按部署拆分：video / image / audio / render（逗号分隔）
WORKER_CAPABILITIES=video,image,audio,render

# Artifact 对象存储。local 保持旧文件兼容；s3/minio 启用临时对象原子晋升
ARTIFACT_STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=fishstudio
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_LIFECYCLE_DAYS=0

# 腾讯云混元生3D API 配置 https://console.cloud.tencent.com/ai3d/packages
TENCENT_AI3D_API_KEY=YOUR_TENCENT_AI3D_API_KEY_HERE
TENCENT_AI3D_BASE_URL=https://api.ai3d.cloud.tencent.com

# 阿里云百炼 Qwen-TTS / Qwen3-Omni 多模态理解配置
# 获取API Key: https://help.aliyun.com/zh/model-studio/get-api-key
# Qwen3-Omni 使用 qwen3-omni-flash，可分析 /storage/images、/storage/audios、/storage/videos 下的上传文件
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY_HERE
# 国内版（北京）: https://dashscope.aliyuncs.com
# 国际版（新加坡）: https://dashscope-intl.aliyuncs.com
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# 人脸检测配置
# 检测方法: opencv（轻量级，使用OpenCV Haar Cascade）或 llm（大模型，使用火山引擎多模态模型）
FACE_DETECTION_METHOD=opencv

# ComfyUI 虚拟人生成配置
# ComfyUI 服务器地址（支持域名或完整URL，如：http://127.0.0.1:8818）
COMFYUI_SERVER_ADDRESS=
# ComfyUI 工作流JSON文件路径（可选，也可以通过工具参数传入）
# 例如：/storage/workflow/infinitetalk_workflow.json
COMFYUI_WORKFLOW_PATH=
# 是否向 ComfyUI 发送 Cloudberry/BizyAir 元数据。使用云端算力时设为 true；
# 如果改成本机 ComfyUI + 本机模型，则设为 false。
COMFYUI_CLOUDBERRY_MODE=true

# 日志配置
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Mock 模式（用于调试 agent，不调用真实 API）
# 设置为 true 时，图片生成、视频生成和3D生成将返回固定的 mock 数据
# ⚠️ 注意：启用 MOCK_MODE=true 时，必须配置 MOCK_IMAGE_PATH、MOCK_VIDEO_PATH 和 MOCK_MODEL_PATH
MOCK_MODE=false
# Mock 图片路径（启用 MOCK_MODE 时必须配置，必须是 /storage/images/ 下的文件路径）
# 例如：/storage/images/your_mock_image.png
MOCK_IMAGE_PATH=
# Mock 3D模型路径（启用 MOCK_MODE 时必须配置，必须是 /storage/models/ 下的模型目录路径）
# 例如：/storage/models/your_model_dir
MOCK_MODEL_PATH=
# Mock 视频路径（启用 MOCK_MODE 时必须配置，必须是 /storage/videos/ 下的文件路径）
# 例如：/storage/videos/your_mock_video.mp4
MOCK_VIDEO_PATH=
# Model Runtime: 可注册任意 OpenAI-compatible Chat Deployment（JSON 数组）
# 示例：[{\"name\":\"qwen.prod\",\"provider\":\"dashscope\",\"model\":\"qwen-max\",\"base_url\":\"https://dashscope.aliyuncs.com/compatible-mode/v1\",\"api_key_env\":\"DASHSCOPE_API_KEY\",\"capabilities\":[\"chat\",\"stream\",\"tools\",\"json_schema\"],\"quality_score\":0.9,\"cost_score\":0.7,\"latency_score\":0.8}]
MODEL_RUNTIME_DEPLOYMENTS_JSON=
# 兼容旧 LLM_PROVIDER；新配置优先使用 Deployment 名称
LLM_DEPLOYMENT_NAME=
