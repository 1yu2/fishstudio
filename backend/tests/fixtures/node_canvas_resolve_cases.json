      ],
      "edges": [
        {"source": "t", "target": "img", "targetHandle": "prompt"},
        {"source": "ref", "target": "img", "targetHandle": "reference"}
      ],
      "results": {"ref": ["new", "old"]},
      "aspect_ratio": "9:16",
      "node_id": "img",
      "expected": {
        "request": {"kind": "image", "prompt": "赛博朋克风格\n林夏站在雨里", "model": "seedream", "aspect_ratio": "9:16", "count": 2, "reference_artifact_ids": ["old"]},
        "blockers": []
      }
